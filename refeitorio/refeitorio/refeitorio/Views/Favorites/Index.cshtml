@model List<refeitorio.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Favoritos";
}
<div class="row mb-4">
    <div class="col">
        <h2>Meus Favoritos</h2>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h5>Você ainda não tem favoritos!</h5>
        <p>Adicione produtos aos seus favoritos para acesso rápido.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Ver Produtos</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4" id="favorites-container">
        @foreach (var product in Model)
        {
            <div class="col" id="favorite-card-@product.Id">
                <div class="card h-100">
                    <img src="@product.ImageUrl?v=@DateTime.Now.ToString("yyyyMMdd")" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: contain; image-rendering: pixelated;" />
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted small">@product.Description</p>
                        <p class="card-text"><strong>€@product.Price.ToString("F2")</strong></p>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex gap-2">
                            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="flex-grow-1 ajax-form-cart">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-primary w-100 btn-sm btn-add-cart" data-product-id="@product.Id">
                                    Adicionar
                                </button>
                            </form>
                            <form method="post" asp-controller="Favorites" asp-action="Toggle" class="ajax-form-favorite">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-danger btn-sm btn-favorite" data-product-id="@product.Id">
                                    <span>❤️</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Interceptar submit dos formulários de favoritos
            document.addEventListener('submit', function(e) {
                const form = e.target.closest('.ajax-form-favorite');
                if (form) {
                    e.preventDefault();
                    const productId = form.querySelector('input[name="productId"]').value;
                    toggleFavorite(productId);
                }
            });
        });

        function toggleFavorite(productId) {
            fetch('@Url.Action("Toggle", "Favorites")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `productId=${productId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remover o card da página
                    const card = document.querySelector(`#favorite-card-${productId}`);
                    if (card) {
                        card.style.transition = 'opacity 0.3s ease';
                        card.style.opacity = '0';
                        
                        setTimeout(() => {
                            card.remove();
                            
                            // Verificar se não há mais favoritos
                            const container = document.querySelector('#favorites-container');
                            if (container && container.children.length === 0) {
                                // Mostrar mensagem de lista vazia
                                const emptyMessage = `
                                    <div class="alert alert-info">
                                        <h5>Você ainda não tem favoritos!</h5>
                                        <p>Adicione produtos aos seus favoritos para acesso rápido.</p>
                                        <a href="@Url.Action("Index", "Products")" class="btn btn-primary">Ver Produtos</a>
                                    </div>
                                `;
                                container.outerHTML = emptyMessage;
                            }
                        }, 300);
                    }
                    
                    // Atualizar contador de favoritos no header se existir
                    const favCounter = document.querySelector('#favorites-counter');
                    if (favCounter && data.favoritesCount !== undefined) {
                        favCounter.textContent = data.favoritesCount;
                    }
                }
            })
            .catch(error => {
            });
        }
    </script>
}