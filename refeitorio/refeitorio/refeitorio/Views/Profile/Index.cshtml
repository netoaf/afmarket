@model refeitorio.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Meu Perfil";
}

<style>
    /* Ensure avatar is visible in dark theme */
    #profile-avatar {
        background-color: #007bff !important;
        color: white !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    
    /* Fix any potential CSS conflicts */
    .card-body {
        color: inherit !important;
    }
    
    /* Ensure text is visible */
    h4, p {
        color: inherit !important;
    }
</style>

@functions {
    string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
    }
    
    string GetColorForName(string name)
    {
        if (string.IsNullOrEmpty(name)) return "#007bff"; // Use blue instead of gray for better contrast
        var colors = new[] { "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8", "#F7DC6F", "#BB8FCE", "#85C1E2", "#F06292", "#AED581" };
        int hash = 0;
        foreach (char c in name) hash = ((hash << 5) - hash) + c;
        return colors[Math.Abs(hash) % colors.Length];
    }
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Coluna Esquerda: Foto e Info Básica -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="position-relative d-inline-block mb-4">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img id="profile-image" src="@Model.ProfileImage" alt="Perfil" class="rounded-circle shadow" style="width: 180px; height: 180px; object-fit: cover;" onerror="this.style.display='none'; document.getElementById('profile-avatar').style.display='flex';" />
                        }
                        else
                        {
                            <div id="profile-avatar" class="rounded-circle d-flex align-items-center justify-content-center shadow" 
                                 style="width: 180px; height: 180px; font-size: 60px; font-weight: bold; color: white; background-color: @GetColorForName(Model.Name); display: flex !important;">
                                @GetInitials(Model.Name)
                            </div>
                        }
                    </div>

                    <h4 class="mb-1">@Model.Name</h4>
                    <p class="text-muted mb-3">@Model.UserType</p>
                    
                    <div class="d-grid gap-2">
                        <div class="bg-light rounded p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Saldo Atual</span>
                                <h3 class="mb-0 text-success" id="current-balance">€@Model.Balance.ToString("F2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Coluna Direita: Informações e Ações -->
        <div class="col-lg-8">
            <div class="row g-4">
                <!-- Informações Pessoais -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Informações Pessoais</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small mb-1">Número de Utilizador</label>
                                    <div class="fw-bold">@Model.UserNumber</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small mb-1">Email</label>
                                    <div class="fw-bold">@(string.IsNullOrEmpty(Model.Email) ? "Não definido" : Model.Email)</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small mb-1">Telefone</label>
                                    <div class="fw-bold">@(string.IsNullOrEmpty(Model.Phone) ? "Não definido" : Model.Phone)</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small mb-1">Tipo de Conta</label>
                                    <div>
                                        @if (Model.UserType == "Admin")
                                        {
                                            <span class="badge bg-danger">Administrador</span>
                                        }
                                        else if (Model.UserType == "Staff")
                                        {
                                            <span class="badge bg-warning">Funcionário</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Estudante</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Adicionar Saldo -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0"><i class="bi bi-wallet2 me-2 text-success"></i>Adicionar Saldo</h5>
                        </div>
                        <div class="card-body">
                            <form id="add-balance-form" method="post" asp-action="AddBalance">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-8">
                                        <label for="balance-input" class="form-label">Valor a Adicionar (€)</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text bg-light"><i class="bi bi-currency-euro"></i></span>
                                            <input type="text" class="form-control" id="balance-input" name="balance" placeholder="0,00" required>
                                        </div>
                                        <small class="text-muted">Use vírgula (,) ou ponto (.) para decimais</small>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-success btn-lg w-100">
                                            <i class="bi bi-plus-circle me-2"></i>Adicionar
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Adicionar saldo com validação de decimal
            const balanceForm = document.getElementById('add-balance-form');
            const balanceInput = document.getElementById('balance-input');

            balanceInput.addEventListener('input', function(e) {
                let value = e.target.value;
                value = value.replace(',', '.');
                value = value.replace(/[^0-9.]/g, '');
                const parts = value.split('.');
                if (parts.length > 2) {
                    value = parts[0] + '.' + parts.slice(1).join('');
                }
                e.target.value = value;
            });

            balanceForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                let balanceValue = balanceInput.value.replace(',', '.');
                const balance = parseFloat(balanceValue);

                if (isNaN(balance) || balance <= 0) {
                    showMessage('Por favor, insira um valor válido maior que zero.', 'danger');
                    return;
                }

                const formData = new FormData();
                formData.append('balance', balance.toString());

                try {
                    const response = await fetch('@Url.Action("AddBalance", "Profile")', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        showMessage('Erro ao adicionar saldo. Resposta inválida do servidor.', 'danger');
                        return;
                    }

                    const result = await response.json();

                    if (result.success) {
                        document.getElementById('current-balance').textContent = '€' + result.balance.toFixed(2);
                        balanceInput.value = '';
                    } else {
                        showMessage(result.message || 'Erro ao adicionar saldo.', 'danger');
                    }
                } catch (error) {
                    showMessage('Erro ao adicionar saldo.', 'danger');
                }
            });

            function showMessage(message, type) {
                uploadMessage.className = `alert alert-${type} mt-2`;
                uploadMessage.textContent = message;
                uploadMessage.style.display = 'block';
                setTimeout(() => {
                    uploadMessage.style.display = 'none';
                }, 5000);
            }
        });
    </script>
}
