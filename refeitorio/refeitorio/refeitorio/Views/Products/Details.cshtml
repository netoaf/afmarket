@model refeitorio.ViewModels.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="row mb-4">
    <div class="col">
        <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Voltar aos Produtos</a>
        <h2>@Model.Name</h2>
    </div>
</div>

<div class="row">
    <!-- Imagem do produto -->
    <div class="col-md-5">
        <div class="card">
            <img src="@Model.ImageUrl?v=@DateTime.Now.ToString("yyyyMMdd")" class="card-img-top p-3" alt="@Model.Name" 
                 style="max-height: 350px; object-fit: contain; image-rendering: pixelated;" />
        </div>
    </div>
    
    <!-- Informações do produto -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-3">@Model.Name</h3>
                <p class="card-text">@Model.Description</p>
                
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="h4 mb-0 text-success">€@Model.Price.ToString("F2")</span>
                    <span class="badge bg-secondary">@ViewBag.CategoryName</span>
                    @if (Model.IsVegetarian)
                    {
                        <span class="badge bg-success">Vegetariano</span>
                    }
                    @if (Model.Stock > 0)
                    {
                        <span class="badge bg-info">Em stock: @Model.Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Esgotado</span>
                    }
                </div>
                
                <!-- Alergénios -->
                @if (Model.Allergens != null && Model.Allergens.Any())
                {
                    <div class="mb-3">
                        <h6>Alergénios:</h6>
                        @foreach (var allergen in Model.Allergens)
                        {
                            <span class="badge bg-warning me-1">@allergen</span>
                        }
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <span class="badge bg-success">Sem alergénios declarados</span>
                    </div>
                }
                
                <!-- Ações -->
                <div class="d-flex gap-2 mt-4">
                    <form method="post" asp-controller="Cart" asp-action="AddToCart" class="ajax-form-cart">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-add-cart" data-product-id="@Model.Id">
                            Adicionar ao Carrinho
                        </button>
                    </form>
                    
                    <form method="post" asp-controller="Favorites" asp-action="Toggle" class="ajax-form-favorite">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn @(ViewBag.IsFavorite ? "btn-danger" : "btn-outline-danger") btn-favorite" data-product-id="@Model.Id">
                            @if (ViewBag.IsFavorite)
                            {
                                <span>❤️ Favorito</span>
                            }
                            else
                            {
                                <span>🤍 Adicionar aos Favoritos</span>
                            }
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Informação Nutricional -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Informação Nutricional</h5>
                <small class="text-muted">Valores por porção</small>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card">
                            <div class="card-body py-3">
                                <h3 class="mb-0">@Model.Calories</h3>
                                <small>kcal</small>
                                <p class="mb-0 mt-1"><strong>Calorias</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card">
                            <div class="card-body py-3">
                                <h3 class="mb-0">@Model.Protein.ToString("F1")g</h3>
                                <small>&nbsp;</small>
                                <p class="mb-0 mt-1"><strong>Proteína</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card">
                            <div class="card-body py-3">
                                <h3 class="mb-0">@Model.Carbs.ToString("F1")g</h3>
                                <small>&nbsp;</small>
                                <p class="mb-0 mt-1"><strong>Hidratos</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card">
                            <div class="card-body py-3">
                                <h3 class="mb-0">@Model.Fat.ToString("F1")g</h3>
                                <small>&nbsp;</small>
                                <p class="mb-0 mt-1"><strong>Gordura</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
