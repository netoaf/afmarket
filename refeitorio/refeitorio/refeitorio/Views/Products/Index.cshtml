@model List<refeitorio.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Produtos";
}
<style>
    * {
        color: white !important;
    }
</style>

<div class="row mb-4">
    <div class="col">
        <h2>Produtos Disponíveis</h2>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Categoria</label>
                    <select name="categoryId" class="form-select">
                        <option value="">Todas</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.Id" selected="@(ViewBag.SelectedCategoryId == category.Id)">
                                    @category.Name
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pesquisar</label>
                    <input type="text" name="search" class="form-control" placeholder="Nome do produto..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Preço Mín.</label>
                    <input type="number" name="minPrice" class="form-control" placeholder="€0.00" step="0.10" value="@ViewBag.MinPrice" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Preço Máx.</label>
                    <input type="number" name="maxPrice" class="form-control" placeholder="€99.99" step="0.10" value="@ViewBag.MaxPrice" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>
            </div>
            
            <!-- Filtro de alergénios -->
            <div class="mt-3">
                <label class="form-label">Excluir produtos com:</label>
                <div class="row">
                    @if (ViewBag.AllAllergens != null)
                    {
                        foreach (var allergen in (List<string>)ViewBag.AllAllergens)
                        {
                            var isSelected = ViewBag.ExcludeAllergens != null && ((List<string>)ViewBag.ExcludeAllergens).Contains(allergen);
                            <div class="col-md-3 col-6 mb-1">
                                <div class="form-check">
                                    <input type="checkbox" name="excludeAllergens" value="@allergen" 
                                           class="form-check-input" id="exclude-@allergen.Replace(" ", "")" 
                                           @(isSelected ? "checked" : "") />
                                    <label class="form-check-label small" for="exclude-@allergen.Replace(" ", "")">@allergen</label>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Products Grid -->
@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        Nenhum produto encontrado com os filtros aplicados. (Total: @(Model?.Count ?? 0))
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@product.ImageUrl?v=@DateTime.Now.ToString("yyyyMMdd")"
                         class="card-img-top"
                         alt="@product.Name"
                         style="height: 200px; object-fit: contain; image-rendering: pixelated;" />

                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted small">@product.Description</p>
                        <p class="card-text"><strong>€@product.Price.ToString("F2")</strong></p>
                        
                        @if (!string.IsNullOrEmpty(product.Allergens))
                        {
                            <div class="mb-2">
                                @{
                                    var allergenList = product.Allergens.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(a => a.Trim()).ToList();
                                }
                                @foreach (var allergen in allergenList.Take(3))
                                {
                                    <span class="badge bg-warning me-1 small">@allergen</span>
                                }
                                @if (allergenList.Count > 3)
                                {
                                    <span class="badge bg-secondary small">+@(allergenList.Count - 3)</span>
                                }
                            </div>
                        }
                        
                        <div class="d-flex gap-2 align-items-center">
                            @if (product.IsVegetarian)
                            {
                                <span class="badge bg-success">Vegetariano</span>
                            }
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info">
                                Ver Detalhes
                            </a>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="d-flex gap-2">
                            <form method="post" asp-controller="Cart" asp-action="AddToCart" class="flex-grow-1 ajax-form-cart">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-primary w-100 btn-sm btn-add-cart" data-product-id="@product.Id">
                                    Adicionar
                                </button>
                            </form>

                            <form method="post" asp-controller="Favorites" asp-action="Toggle" class="ajax-form-favorite">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn @(ViewBag.Favorites != null && ViewBag.Favorites.Contains(product.Id) ? "btn-danger" : "btn-outline-danger") btn-sm btn-favorite" data-product-id="@product.Id">
                                    @if (ViewBag.Favorites != null && ViewBag.Favorites.Contains(product.Id))
                                    {
                                        <span>❤️</span>
                                    }
                                    else
                                    {
                                        <span>🤍</span>
                                    }
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
