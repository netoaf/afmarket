@model List<refeitorio.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Gestão de Categorias - Staff";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-0">
                <i class="bi bi-tags text-primary"></i> 
                Gestão de Categorias
            </h2>
            <p class="text-muted">Gerir categorias de produtos</p>
        </div>
        <div class="col-auto">
            <a asp-action="CreateCategory" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nova Categoria
            </a>
        </div>
    </div>

    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title">@category.Name</h5>
                                <p class="text-muted mb-0">ID: @category.Id</p>
                            </div>
                            <button class="btn btn-sm btn-outline-danger btn-delete-category" data-category-id="@category.Id">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-delete-category').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const categoryId = this.dataset.categoryId;
                    
                    if (!confirm('Tem certeza que deseja eliminar esta categoria?')) {
                        return;
                    }

                    try {
                        const response = await fetch('@Url.Action("DeleteCategory", "Staff")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: `id=${categoryId}`
                        });

                        const data = await response.json();

                        if (data.success) {
                            location.reload();
                        }
                    } catch (error) {
                    }
                });
            });
        });
    </script>
}
