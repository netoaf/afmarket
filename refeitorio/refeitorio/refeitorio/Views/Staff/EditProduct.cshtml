@model refeitorio.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Editar Produto - Staff";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Editar Produto
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditProduct" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Nome</label>
                                <input asp-for="Name" class="form-control" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label">Categoria</label>
                                <select asp-for="CategoryId" class="form-select" required>
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descrição</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Price" class="form-label">Preço (€)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" required>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Stock" class="form-label">Stock</label>
                                <input asp-for="Stock" type="number" class="form-control" required>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Disponível</label>
                                <div class="form-check form-switch">
                                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox">
                                    <label asp-for="IsAvailable" class="form-check-label">Sim</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">URL da Imagem</label>
                            <input asp-for="ImageUrl" class="form-control">
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Calories" class="form-label">Calorias</label>
                                <input asp-for="Calories" type="number" class="form-control">
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Protein" class="form-label">Proteína (g)</label>
                                <input asp-for="Protein" type="number" step="0.1" class="form-control">
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Carbs" class="form-label">Carboidratos (g)</label>
                                <input asp-for="Carbs" type="number" step="0.1" class="form-control">
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Fat" class="form-label">Gordura (g)</label>
                                <input asp-for="Fat" type="number" step="0.1" class="form-control">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Allergens" class="form-label">Alergénios</label>
                            <input asp-for="Allergens" class="form-control">
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsVegetarian" class="form-check-input" type="checkbox">
                            <label asp-for="IsVegetarian" class="form-check-label">Vegetariano</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Guardar Alterações
                            </button>
                            <a asp-action="Products" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
