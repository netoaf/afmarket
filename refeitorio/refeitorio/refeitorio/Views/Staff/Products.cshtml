@model List<refeitorio.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Gestão de Produtos - Staff";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-0">
                <i class="bi bi-box-seam text-primary"></i> 
                Gestão de Produtos e Categorias
            </h2>
            <p class="text-muted">Gerir stock, produtos e categorias</p>
        </div>
        <div class="col-auto">
            <a asp-action="Orders" class="btn btn-outline-primary">
                <i class="bi bi-clipboard-check"></i> Ver Pedidos
            </a>
        </div>
    </div>

    <!-- Gestão de Categorias -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Categorias</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="d-flex flex-wrap gap-2" id="categories-list">
                        @foreach (var category in ViewBag.Categories)
                        {
                            <div class="badge bg-primary p-2 d-flex align-items-center gap-2" style="font-size: 14px;">
                                <span>@category.Name</span>
                                <button class="btn btn-sm btn-link text-white p-0 btn-delete-category" data-category-id="@category.Id" style="text-decoration: none;">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" class="form-control" id="new-category-name" placeholder="Nova categoria">
                        <button class="btn btn-success" id="btn-add-category">
                            <i class="bi bi-plus-circle"></i> Adicionar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Imagem</th>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Stock</th>
                            <th>Disponível</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded">
                                    }
                                </td>
                                <td><strong>@product.Name</strong></td>
                                <td>@ViewBag.CategoryNames[product.CategoryId]</td>
                                <td><strong class="text-primary">€@product.Price.ToString("F2")</strong></td>
                                <td>
                                    <div class="input-group input-group-sm" style="width: 150px;">
                                        <input type="number" class="form-control stock-input" data-product-id="@product.Id" value="@product.Stock" min="0">
                                        <button class="btn btn-outline-success btn-update-stock" data-product-id="@product.Id">
                                            <i class="bi bi-check"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    @if (product.IsAvailable)
                                    {
                                        <span class="badge bg-success">Disponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Indisponível</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Atualizar stock
            document.querySelectorAll('.btn-update-stock').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const productId = this.dataset.productId;
                    const input = document.querySelector(`.stock-input[data-product-id="${productId}"]`);
                    const newStock = parseInt(input.value);

                    if (isNaN(newStock) || newStock < 0) {
                        return;
                    }

                    this.disabled = true;
                    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                    try {
                        const response = await fetch('@Url.Action("UpdateStock", "Staff")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: `productId=${productId}&newStock=${newStock}`
                        });

                        const data = await response.json();

                        if (data.success) {
                            this.innerHTML = '<i class="bi bi-check"></i>';
                            showToast('success', data.message);
                        } else {
                            this.innerHTML = '<i class="bi bi-check"></i>';
                            showToast('danger', data.message);
                        }
                    } catch (error) {
                        this.innerHTML = '<i class="bi bi-check"></i>';
                        showToast('danger', 'Erro ao atualizar stock');
                    }

                    this.disabled = false;
                });
            });

            // Adicionar categoria
            document.getElementById('btn-add-category').addEventListener('click', async function() {
                const input = document.getElementById('new-category-name');
                const categoryName = input.value.trim();

                if (!categoryName) {
                    showToast('warning', 'Digite o nome da categoria');
                    return;
                }

                try {
                    const response = await fetch('@Url.Action("CreateCategory", "Staff")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `Name=${encodeURIComponent(categoryName)}`
                    });

                    if (response.ok) {
                        showToast('success', 'Categoria criada com sucesso!');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast('danger', 'Erro ao criar categoria');
                    }
                } catch (error) {
                    showToast('danger', 'Erro ao criar categoria');
                }
            });

            // Eliminar categoria
            document.querySelectorAll('.btn-delete-category').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const categoryId = this.dataset.categoryId;
                    
                    if (!confirm('Tem certeza que deseja eliminar esta categoria?')) {
                        return;
                    }

                    try {
                        const response = await fetch('@Url.Action("DeleteCategory", "Staff")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: `id=${categoryId}`
                        });

                        const data = await response.json();

                        if (data.success) {
                            showToast('success', data.message);
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showToast('danger', data.message);
                        }
                    } catch (error) {
                        showToast('danger', 'Erro ao eliminar categoria');
                    }
                });
            });

            function showToast(type, message) {
                const toastHtml = `
                    <div class="toast align-items-center text-white bg-${type} border-0 position-fixed top-0 end-0 m-3" role="alert" style="z-index: 9999;">
                        <div class="d-flex">
                            <div class="toast-body">${message}</div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                `;
                
                document.body.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = document.body.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();
                
                toastElement.addEventListener('hidden.bs.toast', () => {
                    toastElement.remove();
                });
            }
        });
    </script>
}
