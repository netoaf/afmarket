@model List<refeitorio.Services.OrderDTO>

@{
    ViewData["Title"] = "Histórico de Pedidos";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-0">
                <i class="bi bi-clock-history text-primary"></i> 
                Histórico de Pedidos
            </h2>
            <p class="text-muted">Visualizar todos os pedidos processados</p>
        </div>
        <div class="col-auto">
            <a asp-action="Orders" class="btn btn-primary">
                <i class="bi bi-clipboard-check"></i> Pedidos Pendentes
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Filtrar por Status</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">Todos</option>
                        <option value="Delivered">Entregues</option>
                        <option value="Rejected">Rejeitados</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pesquisar Utilizador</label>
                    <input type="text" class="form-control" id="userSearch" placeholder="Nome do utilizador...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data Inicial</label>
                    <input type="date" class="form-control" id="dateFrom">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data Final</label>
                    <input type="date" class="form-control" id="dateTo">
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle text-success fs-1"></i>
                    <h3 class="mt-2 mb-0">@Model.Count(o => o.Status == "Delivered")</h3>
                    <small class="text-muted">Entregues</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle text-danger fs-1"></i>
                    <h3 class="mt-2 mb-0">@Model.Count(o => o.Status == "Rejected")</h3>
                    <small class="text-muted">Rejeitados</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-currency-euro text-success fs-1"></i>
                    <h3 class="mt-2 mb-0">€@Model.Where(o => o.Status == "Delivered").Sum(o => o.TotalAmount).ToString("F2")</h3>
                    <small class="text-muted">Total Entregue</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-arrow-return-left text-info fs-1"></i>
                    <h3 class="mt-2 mb-0">€@Model.Where(o => o.Status == "Rejected").Sum(o => o.TotalAmount).ToString("F2")</h3>
                    <small class="text-muted">Total Devolvido</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="ordersTable">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Utilizador</th>
                            <th>Data</th>
                            <th>Itens</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Entregue Em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr data-status="@order.Status" data-user="@order.UserName.ToLower()" data-date="@order.OrderDate.ToString("yyyy-MM-dd")">
                                <td><strong>#@order.Id</strong></td>
                                <td>
                                    <i class="bi bi-person-circle text-primary"></i>
                                    @order.UserName
                                </td>
                                <td>
                                    <small>@order.OrderDate.ToString("dd/MM/yyyy")</small><br>
                                    <small class="text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#items-@order.Id">
                                        <i class="bi bi-eye"></i> Ver (@order.Items.Count)
                                    </button>
                                </td>
                                <td><strong class="text-primary">€@order.TotalAmount.ToString("F2")</strong></td>
                                <td>
                                    @if (order.Status == "Delivered")
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Entregue
                                        </span>
                                    }
                                    else if (order.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i> Rejeitado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@order.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (order.DeliveredAt.HasValue)
                                    {
                                        <small>@order.DeliveredAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-info" type="button" data-bs-toggle="collapse" data-bs-target="#items-@order.Id">
                                        <i class="bi bi-info-circle"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="items-@order.Id">
                                <td colspan="8" class="bg-light">
                                    <div class="p-3">
                                        <h6 class="mb-3"><i class="bi bi-bag"></i> Detalhes do Pedido</h6>
                                        <div class="row">
                                            @foreach (var item in order.Items)
                                            {
                                                <div class="col-md-6 mb-2">
                                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                                        <div>
                                                            <strong>@item.ProductName</strong><br>
                                                            <small class="text-muted">@item.Quantity x €@item.UnitPrice.ToString("F2")</small>
                                                        </div>
                                                        <strong class="text-primary">€@item.TotalPrice.ToString("F2")</strong>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statusFilter = document.getElementById('statusFilter');
            const userSearch = document.getElementById('userSearch');
            const dateFrom = document.getElementById('dateFrom');
            const dateTo = document.getElementById('dateTo');
            const tableRows = document.querySelectorAll('#ordersTable tbody tr[data-status]');

            function filterTable() {
                const statusValue = statusFilter.value.toLowerCase();
                const userValue = userSearch.value.toLowerCase();
                const dateFromValue = dateFrom.value;
                const dateToValue = dateTo.value;

                tableRows.forEach(row => {
                    const rowStatus = row.dataset.status.toLowerCase();
                    const rowUser = row.dataset.user;
                    const rowDate = row.dataset.date;

                    let show = true;

                    // Filter by status
                    if (statusValue && rowStatus !== statusValue) {
                        show = false;
                    }

                    // Filter by user
                    if (userValue && !rowUser.includes(userValue)) {
                        show = false;
                    }

                    // Filter by date range
                    if (dateFromValue && rowDate < dateFromValue) {
                        show = false;
                    }
                    if (dateToValue && rowDate > dateToValue) {
                        show = false;
                    }

                    // Show/hide row and its details
                    row.style.display = show ? '' : 'none';
                    const nextRow = row.nextElementSibling;
                    if (nextRow && nextRow.classList.contains('collapse')) {
                        nextRow.style.display = show ? '' : 'none';
                    }
                });
            }

            statusFilter.addEventListener('change', filterTable);
            userSearch.addEventListener('input', filterTable);
            dateFrom.addEventListener('change', filterTable);
            dateTo.addEventListener('change', filterTable);
        });
    </script>
}
