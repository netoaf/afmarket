@model refeitorio.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="row mb-4">
    <div class="col">
        <h2>✏️ Editar Produto</h2>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="EditProduct">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">Nome</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Descrição</label>
                <textarea name="Description" class="form-control" rows="3" required>@Model.Description</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Preço (€)</label>
                <input type="number" name="Price" class="form-control" value="@Model.Price" step="0.10" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Quantidade</label>
                <input type="number" name="Stock" class="form-control" step="1" value="@Model.Stock" />
            </div>

            <div class="mb-3">
                <label class="form-label">Categoria</label>
                <select name="CategoryId" class="form-select" required>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">URL ou Path da Imagem</label>
                <input type="text" name="ImageUrl" class="form-control" value="@Model.ImageUrl" placeholder="/images/nome.png ou https://..." required />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsAvailable" class="form-check-input" id="isAvailable" />
                <label class="form-check-label" for="isAvailable">Produto Disponível</label>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsVegetarian" class="form-check-input" id="isVegetarian" />
                <label class="form-check-label" for="isVegetarian">Produto Vegetariano</label>
            </div>

            <hr class="my-4" />
            <h5>Valores Nutricionais (por porção)</h5>
            
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Calorias (kcal)</label>
                    <input type="number" name="Calories" class="form-control" min="0" value="@Model.Calories" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Proteína (g)</label>
                    <input type="number" name="Protein" class="form-control" step="0.1" min="0" value="@Model.Protein" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Hidratos (g)</label>
                    <input type="number" name="Carbs" class="form-control" step="0.1" min="0" value="@Model.Carbs" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Gordura (g)</label>
                    <input type="number" name="Fat" class="form-control" step="0.1" min="0" value="@Model.Fat" />
                </div>
            </div>

            <hr class="my-4" />
            <h5>Alergénios</h5>
            <div class="row">
                @foreach (var allergen in refeitorio.ViewModels.AllergenTypes.All)
                {
                    var isChecked = Model.Allergens?.Contains(allergen) == true;
                    <div class="col-md-4 mb-2">
                        <div class="form-check">
                            <input type="checkbox" name="Allergens" value="@allergen" class="form-check-input" 
                                   id="allergen-@allergen.Replace(" ", "")" @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="allergen-@allergen.Replace(" ", "")">@allergen</label>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">Guardar</button>
                <a asp-action="Products" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
