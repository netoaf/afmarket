@model List<refeitorio.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Gestão de Estudantes";
}
<style>
    * {
        color: white !important;
    }
</style>
<div class="row mb-4">
    <div class="col">
        <h2>Gestão de Estudantes</h2>
    </div>
    <div class="col text-end">
        <a asp-action="CreateStudent" class="btn btn-success">Novo Estudante</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th >ID</th>
                        <th >Nome</th>
                        <th >Username</th>
                        <th >Saldo</th>
                        <th >Tipo</th>
                        <th >Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td >@student.Id</td>
                            <td >@student.Name</td>
                            <td >@student.UserNumber</td>
                            <td >€@student.Balance.ToString("F2")</td>
                            <td >@student.UserType</td>
                            <td>
                                <a asp-action="EditStudent" asp-route-id="@student.Id" class="btn btn-sm btn-primary">✏️ Editar</a>
                                <form method="post" asp-action="DeleteStudent" asp-route-id="@student.Id" class="ajax-form" style="display: inline;" onsubmit="return confirm('Tem a certeza que deseja eliminar este estudante?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
