@model List<refeitorio.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Gestão de Produtos";
}
<style>
    * {
        color: white !important;
    }
</style>
<div class="row mb-4">
    <div class="col">
        <h2>Gestão de Produtos</h2>
    </div>
    <div class="col text-end">
        <a asp-action="CreateProduct" class="btn btn-success">Novo Produto</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th >ID</th>
                        <th >Nome</th>
                        <th >Descrição</th>
                        <th >Preço</th>
                        <th >Quant.</th>
                        <th >Categoria</th>
                        <th >Disponível</th>
                        <th >Vegetariano</th>
                        <th >Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        var categoryName = ViewBag.CategoryNames != null && ViewBag.CategoryNames.ContainsKey(product.CategoryId) ? 
                            ViewBag.CategoryNames[product.CategoryId] : "Sem categoria";
                        <tr>
                            <td >@product.Id</td>
                            <td >@product.Name</td>
                            <td >@product.Description</td>
                            <td >€@product.Price.ToString("F2")</td>
                            <td >@product.Stock</td>
                            <td >@categoryName</td>
                            <td>
                                @if (product.IsAvailable)
                                {
                                    <span class="badge bg-success">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Não</span>
                                }
                            <td>
                                @if (product.IsVegetarian)
                                {
                                    <span class="badge bg-success">🌱 Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Não</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Editar</a>
                                <form method="post" asp-action="DeleteProduct" asp-route-id="@product.Id" style="display: inline;" onsubmit="return confirm('Tem a certeza que deseja eliminar este produto?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
