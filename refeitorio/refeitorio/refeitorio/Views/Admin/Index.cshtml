@{
    ViewData["Title"] = "Painel Admin";
}

<div class="row mb-4">
    <div class="col">
        <h2>Painel de Administração</h2>
    </div>
</div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="display-1">👨‍🎓</h1>
                    <h5 class="card-title">Gestão de Utilizadores</h5>
                    <p class="card-text">Criar, editar e remover estudantes do sistema</p>
                    <a asp-action="Students" class="btn btn-primary">Gerir Estudantes</a>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="display-1">🍕</h1>
                    <h5 class="card-title">Gestão de Produtos</h5>
                    <p class="card-text">Criar, editar e remover produtos disponíveis</p>
                    <a asp-action="Products" class="btn btn-primary">Gerir Produtos</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="display-1">📁</h1>
                    <h5 class="card-title">Gestão de Categorias</h5>
                    <p class="card-text">Criar e remover categorias de produtos</p>
                    <a asp-action="Categories" class="btn btn-primary">Gerir Categorias</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h1 class="display-1">📅</h1>
                    <h5 class="card-title">Gestão de Menu Semanal</h5>
                    <p class="card-text">Configurar o menu semanal com almoços e jantares</p>
                    <a asp-action="WeeklyMenu" class="btn btn-primary">Gerir Menu Semanal</a>
                </div>
            </div>
        </div>
    </div>