@model List<refeitorio.ViewModels.CartItemViewModel>
@{
    ViewData["Title"] = "Carrinho";
}
<style>
    * {
        color: white !important;
    }
</style>
<div class="row mb-4">
    <div class="col">
        <h2>Meu Carrinho</h2>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <h5>Seu carrinho está vazio!</h5>
        <p>Adicione produtos da nossa lista para começar suas compras.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Ver Produtos</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Preço</th>
                                <th>Quantidade</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr id="cart-row-@item.ProductId">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.style.display='none'" />
                                            }
                                            else
                                            {
                                                <div class="rounded me-2 bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-image text-white"></i>
                                                </div>
                                            }
                                            <strong>@item.ProductName</strong>
                                        </div>
                                    </td>
                                    <td>€@item.UnitPrice.ToString("F2")</td>
                                    <td>
                                        <form method="post" asp-action="UpdateQuantity" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <div class="input-group" style="width: 120px;">
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary btn-sm">-</button>
                                                <input type="text" class="form-control form-control-sm text-center" id="quantity-@item.ProductId" value="@item.Quantity" readonly />
                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary btn-sm">+</button>
                                            </div>
                                        </form>
                                    </td>
                                    <td><strong id="subtotal-@item.ProductId">€@((item.UnitPrice * item.Quantity).ToString("F2"))</strong></td>
                                    <td>
                                        <form method="post" asp-action="RemoveFromCart" class="d-inline ajax-form">
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <input type="hidden" name="productId" value="@item.ProductId" data-product-id="@item.ProductId" />
                                            <button type="submit" class="btn btn-danger btn-sm">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Resumo do Pedido</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span><strong>Total:</strong></span>
                        <strong class="text-primary" style="font-size: 1.5rem;" id="cart-total">€@ViewBag.Total.ToString("F2")</strong>
                    </div>
                    
                    <div class="alert alert-info small">
                        <strong>Seu saldo:</strong> <span id="user-balance">€@ViewBag.Balance.ToString("F2")</span>
                    </div>

                    <div id="checkout-button-container">
                        @if (ViewBag.Balance >= ViewBag.Total)
                        {
                            <form method="post" asp-action="Checkout" class="ajax-form" id="checkout-form">
                                <button type="submit" class="btn btn-success w-100">
                                    Finalizar Compra
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled id="insufficient-balance-btn">
                                Saldo Insuficiente
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Histórico de Compras -->
@if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
{
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4">📋 Histórico de Compras</h3>
            
            @foreach (var order in ViewBag.RecentOrders)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Pedido #@order.Id</strong>
                            <span class="text-muted ms-2">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div>
                            @if (order.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pendente</span>
                            }
                            else if (order.Status == "Preparing")
                            {
                                <span class="badge bg-info">Em Preparação</span>
                            }
                            else if (order.Status == "Ready")
                            {
                                <span class="badge bg-primary">Pronto</span>
                            }
                            else if (order.Status == "Delivered")
                            {
                                <span class="badge bg-success">Entregue</span>
                            }
                            else if (order.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelado</span>
                            }
                            <strong class="ms-3 text-primary">€@order.TotalAmount.ToString("F2")</strong>
                        </div>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th class="text-center">Quantidade</th>
                                    <th class="text-end">Preço Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">€@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-end">€@item.TotalPrice.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Usar delegação de eventos para botões +/- (funciona mesmo após atualização AJAX)
            document.addEventListener('click', function(e) {
                // Verificar se clicou em botão de atualizar quantidade
                const button = e.target.closest('form[action*="UpdateQuantity"] button[type="submit"]');
                if (button) {
                    e.preventDefault();
                    const form = button.closest('form');
                    const productId = form.querySelector('input[name="productId"]').value;
                    
                    // Obter quantidade atual do input
                    const quantityInput = document.querySelector(`#quantity-${productId}`);
                    const currentQuantity = parseInt(quantityInput.value);
                    
                    // Calcular nova quantidade baseado no texto do botão
                    const isIncrement = button.textContent.trim() === '+';
                    const newQuantity = isIncrement ? currentQuantity + 1 : currentQuantity - 1;
                    
                    // Não permitir quantidade menor que 0
                    if (newQuantity < 0) return;
                    
                    updateQuantity(productId, newQuantity);
                }
            });

            // Usar delegação de eventos para botão remover
            document.addEventListener('submit', function(e) {
                const form = e.target.closest('form[action*="RemoveFromCart"]');
                if (form) {
                    e.preventDefault();
                    const cartItemId = form.querySelector('input[name="cartItemId"]').value;
                    const productId = form.querySelector('input[name="productId"]').value;
                    removeFromCart(cartItemId, productId);
                }
            });
        });

        function updateQuantity(productId, quantity) {
            fetch('@Url.Action("UpdateQuantity", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `productId=${productId}&quantity=${quantity}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.itemRemoved) {
                        // Remover linha do produto
                        const row = document.querySelector(`#cart-row-${productId}`);
                        if (row) row.remove();
                        
                        // Se carrinho vazio, recarregar página
                        if (data.cartCount === 0) {
                            location.reload();
                            return;
                        }
                    } else {
                        // Atualizar quantidade
                        const quantityInput = document.querySelector(`#quantity-${productId}`);
                        if (quantityInput) quantityInput.value = data.itemQuantity;
                        
                        // Atualizar subtotal
                        const subtotal = document.querySelector(`#subtotal-${productId}`);
                        if (subtotal) subtotal.textContent = '€' + data.itemSubtotal.toFixed(2);
                    }
                    
                    // Atualizar contador do carrinho
                    const cartCounter = document.querySelector('#cart-counter');
                    if (cartCounter) cartCounter.textContent = data.cartCount;
                    
                    // Atualizar total
                    const totalElement = document.querySelector('#cart-total');
                    if (totalElement) totalElement.textContent = '€' + data.cartTotal.toFixed(2);
                    
                    const totalMainElement = document.querySelector('#cart-total-main');
                    if (totalMainElement) totalMainElement.textContent = '€' + data.cartTotal.toFixed(2);
                    
                    // Atualizar saldo
                    const balanceElement = document.querySelector('#user-balance');
                    if (balanceElement) balanceElement.textContent = '€' + data.balance.toFixed(2);
                    
                    // Atualizar botão de checkout baseado no saldo
                    updateCheckoutButton(data.balance, data.cartTotal);
                }
            })
            .catch(error => {
            });
        }

        function removeFromCart(cartItemId, productId) {
            fetch('@Url.Action("RemoveFromCart", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `cartItemId=${cartItemId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remover linha
                    const row = document.querySelector(`#cart-row-${productId}`);
                    if (row) row.remove();
                    
                    // Atualizar contador
                    const cartCounter = document.querySelector('#cart-counter');
                    if (cartCounter) cartCounter.textContent = data.cartCount;
                    
                    // Atualizar total
                    const totalElement = document.querySelector('#cart-total');
                    if (totalElement) totalElement.textContent = '€' + data.cartTotal.toFixed(2);
                    
                    const totalMainElement = document.querySelector('#cart-total-main');
                    if (totalMainElement) totalMainElement.textContent = '€' + data.cartTotal.toFixed(2);
                    
                    // Atualizar botão de checkout
                    const balanceElement = document.querySelector('#user-balance');
                    const balance = balanceElement ? parseFloat(balanceElement.textContent.replace('€', '')) : 0;
                    updateCheckoutButton(balance, data.cartTotal);
                    
                    // Se carrinho vazio, recarregar
                    if (data.reload || data.cartCount === 0) {
                        location.reload();
                    }
                }
            })
            .catch(error => {
            });
        }

        function updateCheckoutButton(balance, cartTotal) {
            const container = document.querySelector('#checkout-button-container');
            if (!container) return;
            
            if (balance >= cartTotal) {
                // Saldo suficiente - mostrar botão de finalizar
                container.innerHTML = `
                    <form method="post" action="@Url.Action("Checkout", "Cart")" class="ajax-form" id="checkout-form">
                        <button type="submit" class="btn btn-success w-100">
                            Finalizar Compra
                        </button>
                    </form>
                `;
            } else {
                // Saldo insuficiente - mostrar botão desativado
                container.innerHTML = `
                    <button class="btn btn-secondary w-100" disabled id="insufficient-balance-btn">
                        Saldo Insuficiente
                    </button>
                `;
            }
        }
    </script>
}
