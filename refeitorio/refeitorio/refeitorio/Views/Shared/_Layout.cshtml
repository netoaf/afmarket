<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - refeitorio</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Seu CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- CSS gerado pelo VS -->
    <link rel="stylesheet" href="~/refeitorio.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar border-bottom">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Products" asp-action="Index">
                    Bar Virtual
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarMain">

                    @if (Context.Session.GetInt32("StudentId") != null)
                    {
                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Products" asp-action="Index">Produtos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Menu" asp-action="Index">Menu Semanal</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Favorites" asp-action="Index">Favoritos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">Carrinho</a>
                            </li>

                            @if (Context.Session.GetString("UserType") == "Staff")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle staff-menu" href="#" id="staffDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-briefcase-fill me-1"></i> <span class="fw-semibold">Funcionário</span>
                                    </a>
                                    <ul class="dropdown-menu staff-dropdown shadow-lg border-0">
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Staff" asp-action="Orders">
                                            <i class="bi bi-clipboard-check me-2 text-primary"></i>
                                            <div>
                                                <div class="fw-medium">Aprovar Pedidos</div>
                                                <small class="text-muted">Gerir pedidos pendentes</small>
                                            </div>
                                        </a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Staff" asp-action="Products">
                                            <i class="bi bi-box-seam me-2 text-success"></i>
                                            <div>
                                                <div class="fw-medium">Gerir Produtos</div>
                                                <small class="text-muted">Editar stock e produtos</small>
                                            </div>
                                        </a></li>
                                        <li><hr class="dropdown-divider my-2"></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Staff" asp-action="OrderHistory">
                                            <i class="bi bi-clock-history me-2 text-info"></i>
                                            <div>
                                                <div class="fw-medium">Histórico</div>
                                                <small class="text-muted">Ver pedidos anteriores</small>
                                            </div>
                                        </a></li>
                                    </ul>
                                </li>
                            }
                            else if (Context.Session.GetString("UserType") == "Admin")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle admin-menu" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-fill-exclamation me-1"></i> <span class="fw-semibold">Admin</span>
                                    </a>
                                    <ul class="dropdown-menu admin-dropdown shadow-lg border-0">
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Admin" asp-action="Students">
                                            <i class="bi bi-people-fill me-2 text-primary"></i>
                                            <div>
                                                <div class="fw-medium">Utilizadores</div>
                                                <small class="text-muted">Gerir contas de utilizadores</small>
                                            </div>
                                        </a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Admin" asp-action="Products">
                                            <i class="bi bi-box-seam-fill me-2 text-success"></i>
                                            <div>
                                                <div class="fw-medium">Gerir Produtos</div>
                                                <small class="text-muted">Criar e editar produtos</small>
                                            </div>
                                        </a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Admin" asp-action="Categories">
                                            <i class="bi bi-tags-fill me-2 text-warning"></i>
                                            <div>
                                                <div class="fw-medium">Categorias</div>
                                                <small class="text-muted">Gerir categorias de produtos</small>
                                            </div>
                                        </a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Admin" asp-action="WeeklyMenu">
                                            <i class="bi bi-calendar-week-fill me-2 text-info"></i>
                                            <div>
                                                <div class="fw-medium">Menus Semanais</div>
                                                <small class="text-muted">Configurar menus da semana</small>
                                            </div>
                                        </a></li>
                                        <li><hr class="dropdown-divider my-2"></li>
                                        <li><a class="dropdown-item d-flex align-items-center" asp-controller="Staff" asp-action="Orders">
                                            <i class="bi bi-clipboard-check me-2 text-secondary"></i>
                                            <div>
                                                <div class="fw-medium">Aprovar Pedidos</div>
                                                <small class="text-muted">Gestão de pedidos</small>
                                            </div>
                                        </a></li>
                                    </ul>
                                </li>
                            }

                        </ul>

                        <ul class="navbar-nav">

                            <li class="nav-item">
                                <span class="nav-link user-info-text">
                                    Olá, @Context.Session.GetString("StudentName") |
                                    Saldo: €@ViewBag.Balance
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" asp-controller="Profile" asp-action="Index">
                                    @{
                                        var userName = Context.Session.GetString("StudentName") ?? "U";
                                        var profileImage = ViewBag.ProfileImage as string;
                                        var initials = string.Join("", userName.Split(' ').Take(2).Select(n => n[0])).ToUpper();
                                        var colors = new[] { "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8", "#F7DC6F", "#BB8FCE", "#85C1E2" };
                                        var colorIndex = Math.Abs(userName.GetHashCode()) % colors.Length;
                                        
                                        if (!string.IsNullOrEmpty(profileImage))
                                        {
                                            <img src="@profileImage" alt="Perfil" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                            <div class="rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: @colors[colorIndex]; font-weight: bold; font-size: 14px; display: none;">
                                                @initials
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: @colors[colorIndex]; font-weight: bold; font-size: 14px;">
                                                @initials
                                            </div>
                                        }
                                    }
                                    <span>Meu Perfil</span>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Logout">Sair</a>
                            </li>

                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>


    <!-- CONTEÚDO -->
    <div class="container pt-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <!-- FOOTER PIXEL -->
    <footer class="footer py-3 custom-footer text-muted border-top">
        <div class="container text-center">
            &copy; 2025 - refeitorio -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
