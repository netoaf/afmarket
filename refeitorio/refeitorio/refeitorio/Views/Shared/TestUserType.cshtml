@{
    ViewData["Title"] = "Test UserType";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h3>🔍 Teste de UserType na Sessão</h3>
        </div>
        <div class="card-body">
            <h5>Informações da Sessão:</h5>
            <table class="table table-bordered">
                <tr>
                    <th>StudentId</th>
                    <td>@Context.Session.GetInt32("StudentId")</td>
                </tr>
                <tr>
                    <th>StudentName</th>
                    <td>@Context.Session.GetString("StudentName")</td>
                </tr>
                <tr>
                    <th>UserType</th>
                    <td>
                        <strong class="text-primary">@Context.Session.GetString("UserType")</strong>
                        @if (string.IsNullOrEmpty(Context.Session.GetString("UserType")))
                        {
                            <span class="badge bg-danger">NULL ou VAZIO</span>
                        }
                        else if (Context.Session.GetString("UserType") == "Admin")
                        {
                            <span class="badge bg-danger">ADMIN</span>
                        }
                        else if (Context.Session.GetString("UserType") == "Staff")
                        {
                            <span class="badge bg-warning">STAFF</span>
                        }
                        else if (Context.Session.GetString("UserType") == "Student")
                        {
                            <span class="badge bg-success">STUDENT</span>
                        }
                    </td>
                </tr>
            </table>

            <h5 class="mt-4">O que deve aparecer no Navbar:</h5>
            <div class="alert alert-info">
                @if (Context.Session.GetString("UserType") == "Staff")
                {
                    <p>✅ Deve aparecer dropdown <strong class="text-warning">"Funcionário"</strong> (amarelo)</p>
                }
                else if (Context.Session.GetString("UserType") == "Admin")
                {
                    <p>✅ Deve aparecer dropdown <strong class="text-danger">"Admin"</strong> (vermelho)</p>
                }
                else
                {
                    <p>❌ Não deve aparecer nenhum dropdown especial (apenas Student)</p>
                }
            </div>

            <h5 class="mt-4">Ações:</h5>
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-danger">
                <i class="bi bi-box-arrow-right"></i> Fazer Logout
            </a>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary">
                <i class="bi bi-house"></i> Voltar para Home
            </a>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header bg-warning">
            <h5>⚠️ Instruções de Teste</h5>
        </div>
        <div class="card-body">
            <ol>
                <li><strong>Faça Logout</strong> (clique no botão acima)</li>
                <li><strong>Feche TODAS as abas do navegador</strong></li>
                <li><strong>Abra o navegador novamente</strong></li>
                <li><strong>Faça Login com:</strong>
                    <ul>
                        <li><code>admin / Demo-2026!</code> - Deve mostrar "Admin" acima</li>
                        <li><code>func / Demo-2026!</code> - Deve mostrar "Staff" acima</li>
                        <li><code>student / Demo-2026!</code> - Deve mostrar "Student" acima</li>
                    </ul>
                </li>
                <li><strong>Volte para esta página:</strong> <code>/Home/TestUserType</code></li>
                <li><strong>Verifique se o UserType está correto</strong></li>
            </ol>
        </div>
    </div>
</div>
