@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bar Virtual</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h2 class="text-center mb-4">Bar Virtual</h2>
                        <h5 class="text-center text-muted mb-4">Login de Estudante</h5>
                        
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        <form method="post" asp-action="Login" class="ajax-form" id="loginForm">
                            <div class="mb-3">
                                <label for="userNumber" class="form-label">Número</label>
                                <input type="text" class="form-control" id="userNumber" name="userNumber" required />
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100" id="loginButton">Entrar</button>
                        </form>
                        <div class="mt-3 text-center">
                            <a asp-action="Register" class="text-decoration-none">Ainda não tens conta? Regista-te aqui</a>
                        </div>
                        <div class="mt-4">
                            <p class="text-muted small text-center">Credenciais de teste:</p>
                            <ul class="small text-muted">
                                <li>Número: admin, Password: Demo-2026!</li>
                                <li>Número: student, Password: Demo-2026!</li>
                                <li>Número: func, Password: Demo-2026!</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/js/site.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const loginForm = document.getElementById('loginForm');
            
            // Verifica se o formulário existe antes de continuar
            if (!loginForm) {
                return;
            }
            
            const userNumberInput = document.getElementById('userNumber');
            const passwordInput = document.getElementById('password');
            const loginButton = document.getElementById('loginButton');
            
            // Verifica se todos os elementos necessários existem
            if (!userNumberInput || !passwordInput || !loginButton) {
                return;
            }

            // Função para bloquear os campos
            function lockForm() {
                userNumberInput.setAttribute('readonly', 'readonly');
                passwordInput.setAttribute('readonly', 'readonly');
                loginButton.disabled = true;
                loginButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Entrando...';
            }

            // Função para desbloquear os campos
            function unlockForm() {
                userNumberInput.removeAttribute('readonly');
                passwordInput.removeAttribute('readonly');
                loginButton.disabled = false;
                loginButton.innerHTML = 'Entrar';
            }

            // Adiciona o listener para o submit do formulário
            loginForm.addEventListener('submit', function (e) {
                if (loginForm.classList.contains('ajax-form')) {
                    e.preventDefault(); // Previne o submit padrão para formulários AJAX
                    lockForm();
                    
                    const formData = new FormData(loginForm);
                    const searchParams = new URLSearchParams();
                    
                    for (const pair of formData) {
                        searchParams.append(pair[0], pair[1]);
                    }
                    
                    fetch(loginForm.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: searchParams.toString()
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = data.redirect;
                        } else {
                            unlockForm();
                        }
                    })
                    .catch(error => {
                        unlockForm();
                    });
                } else {
                    // Para formulários não-AJAX, apenas bloqueia os campos
                    lockForm();
                }
            });
        });
    </script>
</body>
</html>
