@using refeitorio.Services
@model List<OrderDTO>

@{
    ViewData["Title"] = "Histórico de Compras";
}

<div class="container mt-4">
    <h1 class="mb-4">Histórico de Compras</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            <h5>Você ainda não realizou compras!</h5>
            <p>Seus pedidos serão exibidos aqui após finalizar compras.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Ver Produtos</a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nº Pedido</th>
                                <th>Data</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                            {
                                <tr>
                                    <td>#@order.Id.ToString("D5")</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>€@order.TotalAmount.ToString("F2")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Pendente":
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                                break;
                                            case "Preparando":
                                                <span class="badge bg-info">Em Preparação</span>
                                                break;
                                            case "Pronto":
                                                <span class="badge bg-primary">Pronto para Retirada</span>
                                                break;
                                            case "Entregue":
                                                <span class="badge bg-success">Entregue</span>
                                                break;
                                            case "Cancelado":
                                                <span class="badge bg-danger">Cancelado</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye"></i> Detalhes
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Voltar para Produtos
            </a>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-person"></i> Meu Perfil
            </a>
        </div>
    }
</div>
