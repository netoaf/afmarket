@{
    ViewData["Title"] = "Diagnóstico de Sistema";
}

<div class="container mt-4">
    <h1>Diagnóstico de Conectividade</h1>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Configuração da API</h4>
                </div>
                <div class="card-body">
                    <p><strong>URL Base da API:</strong> @ViewBag.ApiBaseUrl</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Status da API</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.ApiStatus != null)
                    {
                        <div class="alert @(ViewBag.ApiStatus.IsOnline ? "alert-success" : "alert-danger")">
                            <h5>@ViewBag.ApiStatus.Message</h5>
                            <pre>@ViewBag.ApiStatus.Details</pre>
                        </div>
                    }
                    else if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <h5>Erro ao verificar status da API</h5>
                            <p>@ViewBag.Error</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Testes</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <button id="testAuth" class="btn btn-primary">Testar Autenticação</button>
                        <div id="authResult" class="mt-3" style="display:none;">
                            <pre id="authResultContent" class="bg-light p-3"></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Solução de Problemas</h4>
                </div>
                <div class="card-body">
                    <h5>Passos para resolver problemas de conectividade:</h5>
                    <ol>
                        <li>Certifique-se que a API está rodando em <code>https://localhost:7091</code></li>
                        <li>Verifique se a string de conexão com o banco de dados está correta no arquivo <code>appsettings.json</code> da API</li>
                        <li>Confira se o banco de dados SQL Server está online e acessível</li>
                        <li>Se ocorrer erro de certificado, verifique se o navegador aceita certificados autoassinados</li>
                        <li>Limpe a solução e reconstrua ambos os projetos (API e cliente)</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const testAuthButton = document.getElementById('testAuth');
            const authResult = document.getElementById('authResult');
            const authResultContent = document.getElementById('authResultContent');

            testAuthButton.addEventListener('click', function () {
                testAuthButton.disabled = true;
                testAuthButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Testando...';
                
                fetch('@Url.Action("TestAuth")')
                    .then(response => response.json())
                    .then(data => {
                        authResultContent.textContent = JSON.stringify(data, null, 2);
                        authResult.style.display = 'block';
                        
                        if (data.success) {
                            authResultContent.classList.remove('bg-danger');
                            authResultContent.classList.add('bg-success', 'text-white');
                        } else {
                            authResultContent.classList.remove('bg-success', 'text-white');
                            authResultContent.classList.add('bg-danger', 'text-white');
                        }
                    })
                    .catch(error => {
                        authResultContent.textContent = `Erro: ${error.message}`;
                        authResult.style.display = 'block';
                        authResultContent.classList.remove('bg-success', 'text-white');
                        authResultContent.classList.add('bg-danger', 'text-white');
                    })
                    .finally(() => {
                        testAuthButton.disabled = false;
                        testAuthButton.innerHTML = 'Testar Autenticação';
                    });
            });
        });
    </script>
}
